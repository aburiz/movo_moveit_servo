<?xml version="1.0"?>
<package format="2">
  <name>movo_servo</name>
  <version>0.1.0</version>
  <description>MoveIt Servo launch and configuration for MOVO Jaco arms on ROS Noetic.</description>

  <maintainer email="support@kinova.ca">Kinova Support</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rospy</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>joint_state_controller</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>movo_7dof_moveit_config</exec_depend>
  <exec_depend>movo_description</exec_depend>
  <exec_depend>movo_gazebo</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export/>
</package>
