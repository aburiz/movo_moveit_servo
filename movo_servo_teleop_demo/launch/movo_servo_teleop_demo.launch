<launch>
  <arg name="rviz" default="true" />
  <arg name="launch_joy" default="true" />
  <arg name="joy_dev" default="/dev/input/js0" />
  <arg name="launch_realsense_d455" default="false" />
  <arg name="realsense_namespace" default="d455" />
  <arg name="default_active_arm" default="right" />
  <arg name="enable_left_servo" default="true" />
  <arg name="servo_start_delay" default="18.0" />
  <arg name="load_test_obstacle" default="true" />
  <arg name="use_real_arms" default="false" />
  <arg name="local_machine_ip" default="" />
  <arg name="subnet_mask" default="255.255.255.0" />
  <arg name="real_arms_use_urdf" default="false" />
  <arg name="real_arms_feedback_publish_rate" default="0.1" />
  <arg name="respawn_real_arm_driver" default="true" />
  <arg name="left_arm_ip" default="192.168.131.20" />
  <arg name="right_arm_ip" default="192.168.131.30" />
  <arg name="left_robot_port" default="65535" />
  <arg name="right_robot_port" default="25000" />
  <arg name="left_local_cmd_port" default="25010" />
  <arg name="left_local_broadcast_port" default="25015" />
  <arg name="right_local_cmd_port" default="25000" />
  <arg name="right_local_broadcast_port" default="25005" />
  <arg name="left_arm_serial" default="PJ00900006432489-0" />
  <arg name="right_arm_serial" default="PJ00900006509075-0" />

  <!-- MOVO arm/gripper selection for URDF + SRDF -->
  <env name="MOVO_HAS_KINOVA_ARM" value="true" />
  <env name="MOVO_HAS_TWO_KINOVA_ARMS" value="true" />
  <env name="MOVO_HAS_KINOVA_ARM_7DOF" value="true" />
  <env name="MOVO_HAS_KINOVA_ARM_6DOF" value="false" />
  <env name="MOVO_HAS_BODY" value="true" />
  <env name="USE_KG2_FOR_MOVEIT_CONFIG" value="false" />
  <env name="USE_KG3_FOR_MOVEIT_CONFIG" value="true" />
  <env name="USE_R85_FOR_MOVEIT_CONFIG" value="false" />
  <env name="MOVO_HAS_RIGHT_KG2_GRIPPER" value="false" />
  <env name="MOVO_HAS_LEFT_KG2_GRIPPER" value="false" />
  <env name="MOVO_HAS_RIGHT_KG3_GRIPPER" value="true" />
  <env name="MOVO_HAS_LEFT_KG3_GRIPPER" value="true" />
  <env name="MOVO_HAS_RIGHT_ROBOTIQ_GRIPPER" value="false" />
  <env name="MOVO_HAS_LEFT_ROBOTIQ_GRIPPER" value="false" />

  <!-- Robot model + semantic model -->
  <include file="$(find movo_7dof_moveit_config)/launch/planning_context.launch">
    <arg name="load_robot_description" value="true" />
  </include>

  <node pkg="tf2_ros" type="static_transform_publisher" name="odom_to_base_link_tf"
        args="0 0 0 0 0 0 1 odom base_link" />

  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen" />

  <!-- Optional Phase 1 D455 perception path: keep the existing Kinect mount in
       the robot model, attach the D455 frame tree to it, and relay the D455
       point cloud onto the legacy MOVO topics used by MoveIt and RViz. -->
  <include if="$(arg launch_realsense_d455)"
           file="$(find movo_servo_teleop_demo)/launch/d455_moveit_perception.launch">
    <arg name="camera_namespace" value="$(arg realsense_namespace)" />
  </include>

  <!-- MoveIt core for planning scene + collision model -->
  <include unless="$(arg launch_realsense_d455)" file="$(find movo_7dof_moveit_config)/launch/move_group.launch">
    <arg name="load_robot_description" value="false" />
    <arg name="allow_trajectory_execution" value="true" />
    <arg name="fake_execution" value="true" />
    <arg name="info" value="true" />
  </include>

  <include if="$(arg launch_realsense_d455)" file="$(find movo_7dof_moveit_config)/launch/move_group.launch">
    <arg name="load_robot_description" value="false" />
    <arg name="allow_trajectory_execution" value="true" />
    <arg name="fake_execution" value="true" />
    <arg name="info" value="true" />
    <arg name="moveit_octomap_sensor_params_file"
         value="$(find movo_servo_teleop_demo)/config/d455_moveit_sensors.yaml" />
  </include>

  <include if="$(arg rviz)" file="$(find movo_7dof_moveit_config)/launch/moveit_rviz.launch">
    <arg name="config" value="true" />
  </include>

  <!-- Fake bridge: integrates Servo velocity outputs into /joint_states and publishes dummy Kinova topics -->
  <node pkg="movo_servo_teleop_demo" type="fake_kinova_command_bridge.py"
        name="fake_kinova_command_bridge" output="screen">
    <rosparam command="load" file="$(find movo_servo_teleop_demo)/config/fake_kinova_bridge.yaml" />
  </node>

  <!-- Add a static test obstacle to the MoveIt planning scene -->
  <node if="$(arg load_test_obstacle)" pkg="movo_servo_teleop_demo" type="add_test_obstacles.py"
        name="add_test_obstacles" output="screen">
    <rosparam command="load" file="$(find movo_servo_teleop_demo)/config/obstacles.yaml" />
  </node>

  <!-- Xbox joystick input -->
  <node if="$(arg launch_joy)" pkg="joy" type="joy_node" name="joy_node" output="screen">
    <param name="dev" value="$(arg joy_dev)" />
    <param name="autorepeat_rate" value="100.0" />
    <param name="deadzone" value="0.12" />
  </node>

  <node if="$(arg launch_joy)" pkg="movo_servo_teleop_demo" type="xbox_servo_mapper.py"
        name="xbox_servo_mapper" output="screen">
    <rosparam command="load" file="$(find movo_servo_teleop_demo)/config/xbox_mapping.yaml" />
    <param name="default_active_arm" value="$(arg default_active_arm)" />
  </node>

  <node if="$(eval arg('use_real_arms') and (not arg('local_machine_ip')))"
        pkg="movo_servo_teleop_demo" type="real_arm_launch_error.py" name="real_arm_launch_error"
        output="screen" required="true">
    <param name="message"
           value="use_real_arms:=true requires local_machine_ip:=&lt;CURRENT_PC_IP&gt;. Example: roslaunch movo_servo_teleop_demo movo_servo_teleop_demo.launch use_real_arms:=true local_machine_ip:=192.168.131.101" />
  </node>

  <include if="$(eval arg('use_real_arms') and (arg('local_machine_ip') != ''))"
           file="$(find movo_servo_teleop_demo)/launch/real_kinova_dual_arms.launch">
    <arg name="local_machine_ip" value="$(arg local_machine_ip)" />
    <arg name="subnet_mask" value="$(arg subnet_mask)" />
    <arg name="use_urdf" value="$(arg real_arms_use_urdf)" />
    <arg name="feedback_publish_rate" value="$(arg real_arms_feedback_publish_rate)" />
    <arg name="respawn_driver" value="$(arg respawn_real_arm_driver)" />
    <arg name="left_arm_ip" value="$(arg left_arm_ip)" />
    <arg name="right_arm_ip" value="$(arg right_arm_ip)" />
    <arg name="left_robot_port" value="$(arg left_robot_port)" />
    <arg name="right_robot_port" value="$(arg right_robot_port)" />
    <arg name="left_local_cmd_port" value="$(arg left_local_cmd_port)" />
    <arg name="left_local_broadcast_port" value="$(arg left_local_broadcast_port)" />
    <arg name="right_local_cmd_port" value="$(arg right_local_cmd_port)" />
    <arg name="right_local_broadcast_port" value="$(arg right_local_broadcast_port)" />
    <arg name="left_arm_serial" value="$(arg left_arm_serial)" />
    <arg name="right_arm_serial" value="$(arg right_arm_serial)" />
  </include>

  <node if="$(eval arg('use_real_arms') and (arg('local_machine_ip') != ''))"
        pkg="movo_servo_teleop_demo" type="real_kinova_command_bridge.py"
        name="real_kinova_command_bridge" output="screen">
    <param name="config_namespace" value="/movo_servo_teleop_demo/real_arms" />
  </node>

  <!-- Right arm Servo -->
  <node pkg="movo_servo_teleop_demo" type="delayed_servo_server.sh" name="right_servo_server" output="screen"
        respawn="true" respawn_delay="2.0">
    <env name="SERVO_START_DELAY" value="$(arg servo_start_delay)" />
    <env name="SERVO_WAIT_TIMEOUT" value="45" />
    <env name="SERVO_WAIT_JOINT_TOPIC" value="/joint_states" />
    <env name="SERVO_WAIT_SCENE_SERVICE" value="/get_planning_scene" />
    <rosparam command="load" file="$(find movo_servo_teleop_demo)/config/right_arm_servo.yaml" />
  </node>

  <!-- Left arm Servo (enabled by default for runtime toggle support) -->
  <node if="$(eval arg('enable_left_servo'))" pkg="movo_servo_teleop_demo" type="delayed_servo_server.sh"
        name="left_servo_server" output="screen" respawn="true" respawn_delay="2.0">
    <env name="SERVO_START_DELAY" value="$(arg servo_start_delay)" />
    <env name="SERVO_WAIT_TIMEOUT" value="45" />
    <env name="SERVO_WAIT_JOINT_TOPIC" value="/joint_states" />
    <env name="SERVO_WAIT_SCENE_SERVICE" value="/get_planning_scene" />
    <rosparam command="load" file="$(find movo_servo_teleop_demo)/config/left_arm_servo.yaml" />
  </node>
</launch>
