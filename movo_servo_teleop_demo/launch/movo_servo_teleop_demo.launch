<launch>
  <arg name="rviz" default="true" />
  <arg name="launch_joy" default="true" />
  <arg name="joy_dev" default="/dev/input/js0" />
  <arg name="default_active_arm" default="right" />
  <arg name="enable_left_servo" default="false" />
  <arg name="servo_start_delay" default="18.0" />

  <!-- MOVO arm/gripper selection for URDF + SRDF -->
  <env name="MOVO_HAS_KINOVA_ARM" value="true" />
  <env name="MOVO_HAS_TWO_KINOVA_ARMS" value="true" />
  <env name="MOVO_HAS_KINOVA_ARM_7DOF" value="true" />
  <env name="MOVO_HAS_KINOVA_ARM_6DOF" value="false" />
  <env name="MOVO_HAS_BODY" value="true" />
  <env name="USE_KG2_FOR_MOVEIT_CONFIG" value="false" />
  <env name="USE_KG3_FOR_MOVEIT_CONFIG" value="true" />
  <env name="USE_R85_FOR_MOVEIT_CONFIG" value="false" />
  <env name="MOVO_HAS_RIGHT_KG2_GRIPPER" value="false" />
  <env name="MOVO_HAS_LEFT_KG2_GRIPPER" value="false" />
  <env name="MOVO_HAS_RIGHT_KG3_GRIPPER" value="true" />
  <env name="MOVO_HAS_LEFT_KG3_GRIPPER" value="true" />
  <env name="MOVO_HAS_RIGHT_ROBOTIQ_GRIPPER" value="false" />
  <env name="MOVO_HAS_LEFT_ROBOTIQ_GRIPPER" value="false" />

  <!-- Robot model + semantic model -->
  <include file="$(find movo_7dof_moveit_config)/launch/planning_context.launch">
    <arg name="load_robot_description" value="true" />
  </include>

  <node pkg="tf2_ros" type="static_transform_publisher" name="odom_to_base_link_tf"
        args="0 0 0 0 0 0 1 odom base_link" />

  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen" />

  <!-- MoveIt core for planning scene + collision model -->
  <include file="$(find movo_7dof_moveit_config)/launch/move_group.launch">
    <arg name="load_robot_description" value="false" />
    <arg name="allow_trajectory_execution" value="true" />
    <arg name="fake_execution" value="true" />
    <arg name="info" value="true" />
  </include>

  <include if="$(arg rviz)" file="$(find movo_7dof_moveit_config)/launch/moveit_rviz.launch">
    <arg name="config" value="true" />
  </include>

  <!-- Fake bridge: integrates Servo velocity outputs into /joint_states and publishes dummy Kinova topics -->
  <node pkg="movo_servo_teleop_demo" type="fake_kinova_command_bridge.py"
        name="fake_kinova_command_bridge" output="screen">
    <rosparam command="load" file="$(find movo_servo_teleop_demo)/config/fake_kinova_bridge.yaml" />
  </node>

  <!-- Add a static test obstacle to the MoveIt planning scene -->
  <node pkg="movo_servo_teleop_demo" type="add_test_obstacles.py"
        name="add_test_obstacles" output="screen">
    <rosparam command="load" file="$(find movo_servo_teleop_demo)/config/obstacles.yaml" />
  </node>

  <!-- Xbox joystick input -->
  <node if="$(arg launch_joy)" pkg="joy" type="joy_node" name="joy_node" output="screen">
    <param name="dev" value="$(arg joy_dev)" />
    <param name="autorepeat_rate" value="100.0" />
    <param name="deadzone" value="0.12" />
  </node>

  <node if="$(arg launch_joy)" pkg="movo_servo_teleop_demo" type="xbox_servo_mapper.py"
        name="xbox_servo_mapper" output="screen">
    <rosparam command="load" file="$(find movo_servo_teleop_demo)/config/xbox_mapping.yaml" />
    <param name="default_active_arm" value="$(arg default_active_arm)" />
  </node>

  <!-- Right arm Servo -->
  <node pkg="movo_servo_teleop_demo" type="delayed_servo_server.sh" name="right_servo_server" output="screen"
        respawn="true" respawn_delay="2.0">
    <env name="SERVO_START_DELAY" value="$(arg servo_start_delay)" />
    <env name="SERVO_WAIT_TIMEOUT" value="45" />
    <env name="SERVO_WAIT_JOINT_TOPIC" value="/joint_states" />
    <env name="SERVO_WAIT_SCENE_SERVICE" value="/get_planning_scene" />
    <rosparam command="load" file="$(find movo_servo_teleop_demo)/config/right_arm_servo.yaml" />
  </node>

  <!-- Left arm Servo (enabled by default for runtime toggle support) -->
  <node if="$(eval arg('enable_left_servo'))" pkg="movo_servo_teleop_demo" type="delayed_servo_server.sh"
        name="left_servo_server" output="screen" respawn="true" respawn_delay="2.0">
    <env name="SERVO_START_DELAY" value="$(arg servo_start_delay)" />
    <env name="SERVO_WAIT_TIMEOUT" value="45" />
    <env name="SERVO_WAIT_JOINT_TOPIC" value="/joint_states" />
    <env name="SERVO_WAIT_SCENE_SERVICE" value="/get_planning_scene" />
    <rosparam command="load" file="$(find movo_servo_teleop_demo)/config/left_arm_servo.yaml" />
  </node>
</launch>
