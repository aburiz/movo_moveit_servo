<launch>
  <arg name="camera_namespace" default="d455" />
  <arg name="serial_no" default="" />
  <arg name="initial_reset" default="true" />
  <arg name="align_depth" default="true" />
  <arg name="enable_sync" default="true" />
  <arg name="enable_pointcloud" default="true" />
  <arg name="depth_width" default="640" />
  <arg name="depth_height" default="480" />
  <arg name="depth_fps" default="30" />
  <arg name="color_width" default="640" />
  <arg name="color_height" default="480" />
  <arg name="color_fps" default="30" />
  <arg name="clip_distance" default="6.0" />

  <!-- Keep the existing MOVO Kinect mount in the robot model for Phase 1.
       The D455 publishes its own frame tree rooted at d455_link and we attach
       that tree to the old Kinect mount with a single static transform. -->
  <arg name="mount_parent_frame" default="kinect2_link" />
  <arg name="mount_x" default="0.0" />
  <arg name="mount_y" default="0.0" />
  <arg name="mount_z" default="0.0" />
  <arg name="mount_roll" default="0.0" />
  <arg name="mount_pitch" default="0.0" />
  <arg name="mount_yaw" default="0.0" />

  <node pkg="tf2_ros" type="static_transform_publisher" name="d455_mount_tf"
        args="$(arg mount_x) $(arg mount_y) $(arg mount_z) $(arg mount_yaw) $(arg mount_pitch) $(arg mount_roll) $(arg mount_parent_frame) d455_link" />

  <group>
    <!-- Prefer the apt-installed realsense2_camera nodelet library over any
         stale overlay copy in another sourced workspace. -->
    <env name="LD_LIBRARY_PATH" value="/opt/ros/noetic/lib:$(optenv LD_LIBRARY_PATH '')" />
    <env name="CMAKE_PREFIX_PATH" value="/opt/ros/noetic" />
    <env name="ROS_PACKAGE_PATH" value="/opt/ros/noetic/share" />

    <include file="$(find realsense2_camera)/launch/rs_camera.launch">
      <arg name="camera" value="$(arg camera_namespace)" />
      <arg name="tf_prefix" value="d455" />
      <arg name="serial_no" value="$(arg serial_no)" />
      <arg name="enable_depth" value="true" />
      <arg name="enable_color" value="true" />
      <arg name="enable_infra" value="false" />
      <arg name="enable_infra1" value="false" />
      <arg name="enable_infra2" value="false" />
      <arg name="enable_pointcloud" value="$(arg enable_pointcloud)" />
      <arg name="align_depth" value="$(arg align_depth)" />
      <arg name="enable_sync" value="$(arg enable_sync)" />
      <arg name="filters" value="pointcloud" />
      <arg name="depth_width" value="$(arg depth_width)" />
      <arg name="depth_height" value="$(arg depth_height)" />
      <arg name="depth_fps" value="$(arg depth_fps)" />
      <arg name="color_width" value="$(arg color_width)" />
      <arg name="color_height" value="$(arg color_height)" />
      <arg name="color_fps" value="$(arg color_fps)" />
      <arg name="publish_tf" value="true" />
      <arg name="tf_publish_rate" value="0" />
      <arg name="clip_distance" value="$(arg clip_distance)" />
      <arg name="initial_reset" value="$(arg initial_reset)" />
    </include>
  </group>

  <!-- Preserve the existing MOVO topic names so MoveIt and RViz configs can
       consume the D455 point cloud without broader rewiring in Phase 1. -->
  <node pkg="topic_tools" type="relay" name="d455_to_kinect_points" output="screen"
        args="/$(arg camera_namespace)/depth/color/points /kinect/sd/points" />
  <node pkg="topic_tools" type="relay" name="d455_to_kinect2_points" output="screen"
        args="/$(arg camera_namespace)/depth/color/points /kinect2/sd/points" />
</launch>
