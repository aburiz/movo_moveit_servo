<?xml version="1.0"?>
<package format="2">
  <name>movo_servo_teleop_demo</name>
  <version>0.1.0</version>
  <description>ROS 1 Noetic RViz-only proof of concept for MOVO arm teleoperation with MoveIt Servo and Xbox input.</description>

  <maintainer email="abu@example.com">abu</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>joy</exec_depend>
  <exec_depend>moveit_commander</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>movo_7dof_moveit_config</exec_depend>
  <exec_depend>movo_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>tf</exec_depend>

  <export/>
</package>
