<launch>

  <!-- This file makes it easy to include the settings for sensor managers -->  

  <!-- Params for the octomap monitor -->
  <!--  <param name="octomap_frame" type="string" value="some frame in which the robot moves" /> -->
  <param name="octomap_resolution" type="double" value="0.025" />
  <arg name="octomap_max_range" default="5.0" />
  <param name="max_range" type="double" value="$(arg octomap_max_range)" />

  <!-- Load the robot specific sensor manager; this sets the moveit_sensor_manager ROS parameter -->
  <arg name="moveit_sensor_manager" default="movo" />
  <arg name="moveit_octomap_sensor_params_file" default="$(find movo_7dof_moveit_config)/config/sensors.yaml" />
  <arg name="use_depth_image_octomap_updater" default="false" />
  <arg name="depth_image_topic" default="/camera/depth_registered/image_raw" />
  <arg name="depth_image_queue_size" default="5" />
  <arg name="depth_image_near_clipping_plane_distance" default="0.2" />
  <arg name="depth_image_far_clipping_plane_distance" default="5.0" />
  <arg name="depth_image_shadow_threshold" default="0.2" />
  <arg name="depth_image_padding_scale" default="4.0" />
  <arg name="depth_image_padding_offset" default="0.03" />
  <arg name="depth_image_max_update_rate" default="15.0" />
  <arg name="depth_image_filtered_cloud_topic" default="filtered_cloud" />

  <include unless="$(arg use_depth_image_octomap_updater)"
           file="$(find movo_7dof_moveit_config)/launch/$(arg moveit_sensor_manager)_moveit_sensor_manager.launch.xml">
    <arg name="moveit_octomap_sensor_params_file" value="$(arg moveit_octomap_sensor_params_file)" />
  </include>

  <rosparam if="$(arg use_depth_image_octomap_updater)" param="sensors" subst_value="true">
    - sensor_plugin: occupancy_map_monitor/DepthImageOctomapUpdater
      image_topic: $(arg depth_image_topic)
      queue_size: $(arg depth_image_queue_size)
      near_clipping_plane_distance: $(arg depth_image_near_clipping_plane_distance)
      far_clipping_plane_distance: $(arg depth_image_far_clipping_plane_distance)
      shadow_threshold: $(arg depth_image_shadow_threshold)
      padding_scale: $(arg depth_image_padding_scale)
      padding_offset: $(arg depth_image_padding_offset)
      max_update_rate: $(arg depth_image_max_update_rate)
      filtered_cloud_topic: $(arg depth_image_filtered_cloud_topic)
  </rosparam>
  
</launch>
